# Copy to .env. Process environment wins over .env; blank values mean unset.
# Install only integrations you need: pip install -e '.[dev,groq,gemini]'
# Available extras: groq, gemini, openai, deepseek, anthropic, ollama.
# Start with the Gemini-only smoke test documented in README.md.
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash-lite

# After the Gemini test succeeds, optionally move frontend generation to Groq:
# FRONTEND_MODEL_PROVIDER=groq
# FRONTEND_MODEL_NAME=openai/gpt-oss-20b
# FRONTEND_MAX_TOKENS=2048
# This uses GROQ_API_KEY despite the openai/ model prefix.

# Role settings override global settings independently. When changing a role's
# provider, also set its model name if the global model belongs to another provider.
# PLANNER_MODEL_PROVIDER=gemini
# PLANNER_MODEL_NAME=gemini-2.5-flash
# FRONTEND_MODEL_PROVIDER=ollama
# FRONTEND_MODEL_NAME=qwen2.5-coder:7b
# BACKEND_MODEL_PROVIDER=deepseek
# BACKEND_MODEL_NAME=deepseek-chat
# VALIDATION_MODEL_PROVIDER=openai
# VALIDATION_MODEL_NAME=gpt-4o-mini
# Validation currently writes artifacts/checks errors; it does NOT invoke an LLM.
# The factory accepts the validation role for future callers.

# Omitted parameters use the integration's defaults (no temperature is forced).
TEMPERATURE=0.1
MAX_TOKENS=2048
# PLANNER_TEMPERATURE=0
# Compact planner (<180 words); choose a budget below your account's output quota.
# Reasoning tokens can consume this budget. No setting guarantees against truncation.
PLANNER_MAX_TOKENS=800
# FRONTEND_MAX_TOKENS=4096
# BACKEND_MAX_TOKENS=4096
# VALIDATION_MAX_TOKENS=1024
# A 1,000 output-token/minute account also needs pacing across agents/runs;
# a per-call token cap is not a per-minute quota. Retries honor Retry-After up to cap.

GROQ_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=  # Gemini fallback
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# MODEL_API_KEY=  # Optional global credential override
# PLANNER_MODEL_API_KEY=  # Role credential override (wins over provider key)
# OLLAMA_BASE_URL=http://localhost:11434

# Provider switch examples (replace MODEL_PROVIDER and MODEL_NAME above):
# openai:    MODEL_PROVIDER=openai     MODEL_NAME=gpt-4o-mini
# gemini:    MODEL_PROVIDER=gemini     MODEL_NAME=gemini-2.5-flash
# deepseek:  MODEL_PROVIDER=deepseek   MODEL_NAME=deepseek-chat
# anthropic: MODEL_PROVIDER=anthropic MODEL_NAME=claude-sonnet-4-5
# ollama:    MODEL_PROVIDER=ollama     MODEL_NAME=qwen2.5-coder:7b
# Model IDs are examples; choose a model available to your account/server.

# Any new OpenAI-compatible provider requires no repository edits:
# MODEL_PROVIDER=myprovider
# MODEL_NAME=my-model-id
# MODEL_BASE_URL=https://provider.example/v1
# MYPROVIDER_API_KEY=...
# Install: pip install langchain-openai
# Role endpoints: PLANNER_MODEL_BASE_URL, FRONTEND_MODEL_BASE_URL, etc.
# Provider-specific endpoints: OPENAI_BASE_URL, DEEPSEEK_BASE_URL, etc.

# Any custom LangChain integration (install its package first):
# MODEL_PROVIDER=myprovider
# MODEL_CLASS=my_langchain_package:ChatCustom
# MODEL_NAME=my-model-id
# MODEL_KWARGS={"custom_option":true}
# PLANNER_MODEL_CLASS=my_langchain_package:ChatCustom
# PLANNER_MODEL_KWARGS={"custom_option":false}
# Global JSON kwargs merge with role JSON kwargs (role wins).
# Explicit model/key/endpoint/token/temperature env settings win over JSON kwargs.
# For custom integrations, supply provider-specific key/parameter names in kwargs.
# MODEL_CLASS and MODEL_BASE_URL are inherited globally just like MODEL_NAME.

# Total invocation attempts, including first call. All support role prefixes:
LLM_MAX_ATTEMPTS=4
LLM_RETRY_BASE_SECONDS=5
LLM_RETRY_MAX_SECONDS=60
# PLANNER_LLM_MAX_ATTEMPTS=6
# BACKEND_LLM_RETRY_BASE_SECONDS=2
# No retries on authentication/configuration/parser errors.

# Legacy fallbacks retained: ORCHESTRATOR_MODEL_PROVIDER, GROQ_MODEL,
# GEMINI_MODEL, PLANNER_GROQ_MODEL (and other ROLE_PROVIDER_MODEL variants).
# CLI --workspace takes precedence over legacy TARGET_WORKSPACE_DIR.
