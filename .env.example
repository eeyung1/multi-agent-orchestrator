# Global Default Provider: groq or gemini
ORCHESTRATOR_MODEL_PROVIDER=groq

# Optional Per-Agent Role Overrides (leave commented out to use global default)
# PLANNER_MODEL_PROVIDER=gemini
# FRONTEND_MODEL_PROVIDER=groq
# BACKEND_MODEL_PROVIDER=groq

# Groq API Key (Free tier: console.groq.com)
GROQ_API_KEY=

# Google Gemini API Key (Free tier: aistudio.google.com)
GEMINI_API_KEY=
